{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ],
      "source": "/service-worker.js"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "source": "/manifest.json"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ],
      "source": "/index.html"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ],
      "source": "/app.js"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ],
      "source": "/db.js"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ],
      "source": "/supabase-config.js"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ],
      "source": "/styles.css"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/vendor/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ],
      "source": "/icons/(.*)"
    }
  ],
  "outputDirectory": "pwa"
}